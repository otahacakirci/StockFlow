@model StockFlow.ViewModels.Categories.CategoryInputModel

@{
    ViewData["Title"] = "Yeni kategori";
}

<div class="page-heading">
    <div>
        <p class="page-eyebrow">KATEGORİ YÖNETİMİ</p>
        <h1>Yeni kategori</h1>
        <p class="page-intro">Ürünleri gruplamak için yeni bir kategori oluşturun.</p>
    </div>
</div>

<section class="management-panel form-panel" aria-labelledby="create-category-title">
    <h2 id="create-category-title" class="visually-hidden">Kategori oluşturma formu</h2>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <partial name="_FormFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Kategoriyi oluştur</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
