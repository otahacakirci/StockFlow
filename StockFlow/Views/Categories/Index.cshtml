@using StockFlow.Security
@using StockFlow.ViewModels.Categories
@model CategoryListViewModel

@{
    ViewData["Title"] = "Kategoriler";
    var canManageCategories = User.IsInRole(AppRoles.Admin);
    var editReturnUrl = Url.Action(
        "Index",
        "Categories",
        new
        {
            Model.SearchTerm,
            Model.SortOrder,
            Model.Page,
            Model.PageSize
        }) ?? "/Categories";
}

<div class="page-heading">
    <div>
        <p class="page-eyebrow">ÜRÜN KATALOĞU</p>
        <h1>Kategoriler</h1>
        <p class="page-intro">Ürün gruplarını arayın, sıralayın ve bağlı ürün sayılarını izleyin.</p>
    </div>
    @if (canManageCategories)
    {
        <a asp-action="Create" class="btn btn-primary">Yeni kategori</a>
    }
</div>

<section class="management-panel" aria-labelledby="category-filter-title">
    <h2 id="category-filter-title" class="visually-hidden">Kategori filtreleri</h2>
    <form asp-action="Index" method="get" class="management-toolbar">
        <div class="management-toolbar__search">
            <label for="category-search" class="form-label">Kategori ara</label>
            <input id="category-search" name="SearchTerm" value="@Model.SearchTerm"
                   class="form-control" maxlength="100" placeholder="Kategori adı" />
        </div>
        <div>
            <label for="category-sort" class="form-label">Sıralama</label>
            <select id="category-sort" name="SortOrder" class="form-select">
                <option value="@CategorySortOrder.NameAscending"
                        selected="@(Model.SortOrder == CategorySortOrder.NameAscending)">Ada göre A-Z</option>
                <option value="@CategorySortOrder.NameDescending"
                        selected="@(Model.SortOrder == CategorySortOrder.NameDescending)">Ada göre Z-A</option>
            </select>
        </div>
        <div>
            <label for="category-page-size" class="form-label">Sayfa boyutu</label>
            <select id="category-page-size" name="PageSize" class="form-select">
                @foreach (var pageSize in new[] { 10, 20, 50, 100 })
                {
                    <option value="@pageSize" selected="@(Model.PageSize == pageSize)">@pageSize</option>
                }
            </select>
        </div>
        <div class="management-toolbar__actions">
            <button type="submit" class="btn btn-primary">Uygula</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        </div>
    </form>
</section>

<section class="management-panel mt-4" aria-labelledby="category-list-title">
    <div class="management-panel__header">
        <div>
            <p class="page-eyebrow mb-1">KAYITLAR</p>
            <h2 id="category-list-title">Kategori listesi</h2>
        </div>
        <span class="count-pill">@Model.TotalCount kayıt</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="management-empty-state">
            <span aria-hidden="true">—</span>
            <h3>Gösterilecek kategori yok</h3>
            <p>Arama ölçütlerini temizleyin veya yetkiniz varsa yeni bir kategori oluşturun.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <caption class="visually-hidden">Kategori kayıtları</caption>
                <thead>
                    <tr>
                        <th scope="col">Kategori adı</th>
                        <th scope="col">Bağlı ürün</th>
                        <th scope="col" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Items)
                    {
                        <tr>
                            <td><span class="entity-title">@category.Name</span></td>
                            <td><span class="count-badge">@category.ProductCount</span></td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a asp-action="Details" asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                                    @if (canManageCategories)
                                    {
                                        <a asp-action="Edit" asp-route-id="@category.Id"
                                           asp-route-returnUrl="@editReturnUrl"
                                           class="btn btn-sm btn-outline-primary">Düzenle</a>
                                        @if (category.ProductCount == 0)
                                        {
                                            <a asp-action="Delete" asp-route-id="@category.Id"
                                               class="btn btn-sm btn-outline-danger">Sil</a>
                                        }
                                        else
                                        {
                                            <span class="table-action-note">Ürün bağlı</span>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination-bar" aria-label="Kategori sayfaları">
            @if (Model.Page > 1)
            {
                <a asp-action="Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-SortOrder="@Model.SortOrder"
                   asp-route-Page="@(Model.Page - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   class="btn btn-sm btn-outline-secondary">Önceki</a>
            }
            else
            {
                <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Önceki</span>
            }

            <span>Sayfa <strong>@Model.Page</strong> / @Model.TotalPages</span>

            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-SortOrder="@Model.SortOrder"
                   asp-route-Page="@(Model.Page + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   class="btn btn-sm btn-outline-secondary">Sonraki</a>
            }
            else
            {
                <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Sonraki</span>
            }
        </nav>
    }
</section>
