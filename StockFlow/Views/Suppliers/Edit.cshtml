@model StockFlow.ViewModels.Suppliers.SupplierEditPageViewModel

@{
    ViewData["Title"] = "Tedarikçi düzenle";
}

<div class="page-heading">
    <div>
        <p class="page-eyebrow">TEDARİKÇİ YÖNETİMİ</p>
        <h1>Tedarikçiyi düzenle</h1>
        <p class="page-intro">Şirket ve iletişim bilgilerini güncelleyin. Sipariş geçmişi etkilenmez.</p>
    </div>
</div>

<section class="management-panel form-panel" aria-labelledby="edit-supplier-title">
    <h2 id="edit-supplier-title" class="visually-hidden">Tedarikçi düzenleme formu</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <partial name="_FormFields" for="Input" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
