@using StockFlow.Security
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canViewReadScreens = isAuthenticated &&
        (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Employee));
    var isDashboard = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Home",
        StringComparison.OrdinalIgnoreCase) &&
        string.Equals(
            ViewContext.RouteData.Values["action"]?.ToString(),
            "Index",
            StringComparison.OrdinalIgnoreCase);
    var isCategories = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Categories",
        StringComparison.OrdinalIgnoreCase);
    var isProducts = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Products",
        StringComparison.OrdinalIgnoreCase);
    var isCustomers = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Customers",
        StringComparison.OrdinalIgnoreCase);
    var isSuppliers = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Suppliers",
        StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StockFlow.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header">
        <nav class="navbar navbar-expand-md navbar-dark" aria-label="Ana navigasyon">
            <div class="container-xl">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand__mark" aria-hidden="true">SF</span>
                    <span class="app-brand__text">
                        <strong>StockFlow</strong>
                        <small>Envanter yönetimi</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Navigasyonu aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavigation" class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        @if (canViewReadScreens)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(isDashboard ? "active" : null)"
                                   aria-current="@(isDashboard ? "page" : null)"
                                   asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(isCategories ? "active" : null)"
                                   aria-current="@(isCategories ? "page" : null)"
                                   asp-area="" asp-controller="Categories" asp-action="Index">Kategoriler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(isProducts ? "active" : null)"
                                   aria-current="@(isProducts ? "page" : null)"
                                   asp-area="" asp-controller="Products" asp-action="Index">Ürünler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(isCustomers ? "active" : null)"
                                   aria-current="@(isCustomers ? "page" : null)"
                                   asp-area="" asp-controller="Customers" asp-action="Index">Müşteriler</a>
                            </li>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link @(isSuppliers ? "active" : null)"
                                       aria-current="@(isSuppliers ? "page" : null)"
                                       asp-area="" asp-controller="Suppliers" asp-action="Index">Tedarikçiler</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl app-content">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert app-alert alert-dismissible fade show" role="status">
                <span>@successMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-xl">
            <span>StockFlow</span>
            <span aria-hidden="true">·</span>
            <span>Stok ve sipariş yönetimi</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
