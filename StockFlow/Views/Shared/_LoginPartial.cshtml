@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex align-items-center gap-2">
        <span class="navbar-text">@User.Identity.Name</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">Çıkış</button>
        </form>
    </div>
}
else
{
    <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Giriş</a>
}
