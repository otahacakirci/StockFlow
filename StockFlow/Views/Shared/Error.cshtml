@model ErrorViewModel
@{
    ViewData["Title"] = "Bir sorun oluştu";
}

<div class="feedback-panel" role="alert">
    <span class="feedback-panel__code" aria-hidden="true">!</span>
    <p class="dashboard-eyebrow">İŞLEM TAMAMLANAMADI</p>
    <h1>Beklenmeyen bir sorun oluştu</h1>
    <p>İşleminiz güvenli biçimde durduruldu. Lütfen tekrar deneyin veya sorun devam ederse destek ekibine başvurun.</p>

    @if (Model.ShowRequestId)
    {
        <p class="feedback-panel__reference">
            Referans kodu: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Dashboard'a dön</a>
</div>
