@model StockFlow.ViewModels.Products.ProductEditPageViewModel

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" autocomplete="off" autofocus />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.Sku" class="form-label"></label>
        <input asp-for="Input.Sku" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Sku" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.CategoryId" class="form-label"></label>
        <select asp-for="Input.CategoryId" class="form-select">
            <option value="0">Kategori seçin</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Price" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Input.Price" asp-format="{0:0.00}" type="text" class="form-control"
                   inputmode="decimal" data-stockflow-turkish-decimal="true"
                   aria-describedby="product-price-format" />
            <span class="input-group-text">₺</span>
        </div>
        <span asp-validation-for="Input.Price" class="text-danger"></span>
        <div id="product-price-format" class="form-text">Örnek: 19,34. Nokta veya binlik ayırıcı kullanmayın.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.MinimumStockQuantity" class="form-label"></label>
        <input asp-for="Input.MinimumStockQuantity" class="form-control" min="0" />
        <span asp-validation-for="Input.MinimumStockQuantity" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <span class="form-label d-block">Mevcut stok</span>
        <div class="readonly-field" aria-label="Mevcut stok miktarı">@Model.CurrentStockQuantity</div>
        <div class="form-text">Stok yalnızca sipariş onayıyla değişir.</div>
    </div>
</div>
