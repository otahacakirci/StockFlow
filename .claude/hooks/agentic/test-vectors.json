{
  "description": "Engine tests for the agentic guard. Both hook runtimes (node, python) must produce exactly these decisions. 'branch' is the current git branch the hook would see; 'root' is CLAUDE_PROJECT_DIR.",
  "policy": {
    "version": 1,
    "projectName": "fixture",
    "verifyCommand": "npm run verify",
    "handoffDir": "docs/designs",
    "protectedBranches": [
      "main",
      "release"
    ],
    "denyCommitOnProtectedBranch": true,
    "protectedPaths": [
      "package-lock.json",
      "dist/**",
      ".env",
      ".env.*",
      "vendor/**"
    ],
    "guardrailPaths": [
      ".claude/hooks/**",
      ".claude/settings.json",
      ".github/CODEOWNERS"
    ],
    "libraryPaths": [
      "CLAUDE.md",
      ".claude/rules/**",
      ".claude/skills/**",
      ".claude/agents/**"
    ],
    "shell": {
      "deny": [
        {
          "pattern": "\\bnpm\\s+publish\\b",
          "reason": "Publishing packages is human-only."
        }
      ],
      "ask": [
        {
          "pattern": "\\bterraform\\s+apply\\b",
          "reason": "Infrastructure changes need human approval."
        }
      ],
      "readonlyCommands": [
        "npm test",
        "npm run lint",
        "npm run verify"
      ]
    },
    "unlistedSubagents": "restricted-main",
    "agents": {
      "planner": {
        "write": [
          "docs/designs/**"
        ],
        "shell": "readonly"
      },
      "api-implementer": {
        "write": [
          "src/api/**",
          "tests/api/**"
        ],
        "shell": "full"
      },
      "web-implementer": {
        "write": [
          "src/web/**",
          "tests/web/**"
        ],
        "shell": "full"
      },
      "test-writer": {
        "write": [
          "tests/**",
          "src/**/*.test.ts"
        ],
        "shell": "full"
      },
      "reviewer": {
        "write": [],
        "shell": "readonly",
        "mcp": "readonly"
      },
      "knowledge-curator": {
        "write": [],
        "library": true,
        "shell": "readonly"
      },
      "auditor": {
        "write": [],
        "shell": "none"
      }
    },
    "approvalPaths": [
      "package.json",
      "**/pyproject.toml",
      ".github/workflows/**"
    ]
  },
  "cases": [
