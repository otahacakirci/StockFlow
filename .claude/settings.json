{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agentic/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agentic/guard.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agentic/audit-log.mjs\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(gh pr merge *)",
      "Bash(glab mr merge *)",
      "Bash(glab mr approve *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Read(./.env)",
      "Read(./**/secrets.json)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Bash(dotnet user-secrets list*)",
      "PowerShell(dotnet user-secrets list*)",
      "PowerShell(git push --force *)",
      "PowerShell(gh pr merge *)",
      "Bash(dotnet nuget push *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(dotnet ef database *)",
      "PowerShell(dotnet ef database *)",
      "PowerShell(git push *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
